# Relay — local Wasp server environment
# Copy to dashboard/.env.server after the Wasp scaffold exists.
# Never commit dashboard/.env.server or share secrets in GitHub/Discord.

# Required: PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required: ElevenLabs browser voice (server only)
ELEVENLABS_API_KEY=
EL_AGENT_INTAKE_ID=

# Required: authenticated ElevenLabs intake server tool
RELAY_TOOL_SECRET=

# Required after Maritime deployment; no trailing slash
PUBLIC_BASE_URL=

# Demo safety
DEMO_MODE=true

# OPTIONAL ONLY — existing Twilio integration, if already working.
# Not required for the judging path; do not delay the browser-based ElevenLabs flow.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
