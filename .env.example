# Relay — environment variables (PRD section 7)
# 1. cp .env.example .env      2. fill in your section      3. NEVER commit .env
# Share real values with the team over a private channel (DM / password manager), not the repo.
# Deploy to Maritime with:  maritime env import relay-core ./.env --reload

# ─── Core / Maritime (owner: C — Lovina) ────────────────────────────────────
# Maritime public URL, no trailing slash. From `maritime create ...` output.
PUBLIC_BASE_URL=https://<agent-id>.mtm.sh
# Shared secret ElevenLabs tools send as header X-Relay-Secret. Generate: openssl rand -hex 24
RELAY_TOOL_SECRET=
DB_PATH=/data/relay.db
TZ=America/Toronto

# ─── ElevenLabs (owner: V — Voice) ──────────────────────────────────────────
# elevenlabs.io → account settings → API keys (needs Agents access)
ELEVENLABS_API_KEY=
# Workspace webhooks → post-call webhook (HMAC) → signing secret
EL_WEBHOOK_SECRET=
# Agents → Phone Numbers → imported Twilio number → its ID (phone_...), NOT the phone number
EL_PHONE_NUMBER_ID=
# Agent IDs (agent_...), from each agent's page
EL_AGENT_INTAKE_ID=
EL_AGENT_VENDOR_ID=
EL_AGENT_CALLBACK_ID=
EL_AGENT_CONFIRM_ID=

# ─── Twilio (owner: V for the number, I for SMS) ────────────────────────────
# console.twilio.com → Account info. Account must be PAID for ElevenLabs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number, E.164 (+1...). Used for SMS only; calls go through ElevenLabs.
TWILIO_FROM_NUMBER=

# ─── alter (owner: I — Integrations) ────────────────────────────────────────
# alterauth.com → API keys (promo code DRTOHWDE)
ALTER_API_KEY=
# Grant IDs from Managed Secrets → grant. Start with APPROVED only.
ALTER_GRANT_BOOK_APPROVED=
ALTER_GRANT_BOOK_STANDARD=
# P1: ElevenLabs key held by alter for dialling
ALTER_GRANT_ELEVENLABS=
# SHA-256 hashes of the raw booking keys (raw keys live ONLY in alter):
#   KEY=$(openssl rand -hex 32); printf %s "$KEY" | sha256sum      (Mac: shasum -a 256)
BOOKING_KEY_APPROVED_SHA256=
BOOKING_KEY_STANDARD_SHA256=
# alter | local   (local = same thresholds in code + approve button on console)
APPROVAL_BACKEND=alter
CALLS_VIA_ALTER=false

# ─── Fiber AI (owner: I) ────────────────────────────────────────────────────
FIBER_API_KEY=

# ─── traceroot (owner: I) ───────────────────────────────────────────────────
# Run `npx -y traceroot-cli@latest setup`; use the names it writes if they differ.
# Note: the traceroot SDK does not read .env itself — load env before initialize().
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=

# ─── Email (owner: I) ───────────────────────────────────────────────────────
# resend.com → API keys. FROM must be on a verified domain (or onboarding@resend.dev for testing).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ─── Console / Ask Relay chat (owner: D) ────────────────────────────────────
# Any AI SDK provider key for the assistant-ui /api/chat route. Put in console/.env.local.
# NEXT_PUBLIC_CORE_URL=https://<agent-id>.mtm.sh
# ANTHROPIC_API_KEY=   (or OPENAI_API_KEY=)

# ─── Demo safety + policy (owner: C) ────────────────────────────────────────
DEMO_MODE=true
# The three stand-in vendor phones (E.164, comma-separated)
DEMO_VENDOR_PHONES=+1...,+1...,+1...
# EVERY number Relay may dial: 3 vendors + customer phone (+ escalation). Server refuses anything else.
DEMO_ALLOWLIST=+1...,+1...,+1...,+1...
HUMAN_ESCALATION_PHONE=+1...
AUTO_APPROVE_LIMIT=250
HARD_CAP=1000
