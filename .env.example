# Relay — local Wasp server environment
# Copy this file to dashboard/.env.server and fill in real values.
# Never commit dashboard/.env.server or share secrets in GitHub/Discord.

# PostgreSQL database used by Prisma/Wasp
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ElevenLabs browser voice session (server only; never expose in client code)
ELEVENLABS_API_KEY=
EL_AGENT_INTAKE_ID=

# Shared secret for the ElevenLabs server tool that saves intake
RELAY_TOOL_SECRET=

# Public Wasp server URL after deployment to Maritime; no trailing slash
PUBLIC_BASE_URL=

# Demo safety
DEMO_MODE=true
