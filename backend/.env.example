# Copy to .env and fill in. Leave ELEVENLABS_API_KEY empty to run in DRY RUN mode
# (outbound calls are logged instead of placed — useful for dashboard work).

PORT=3001

# ElevenLabs
ELEVENLABS_API_KEY=
# The phone number imported into ElevenLabs (Agents > Phone Numbers), its id, not the number itself
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_DISPATCH_AGENT_ID=
ELEVENLABS_CONFIRM_AGENT_ID=
# Optional: HMAC secret for the post-call webhook (set in ElevenLabs workspace webhook settings)
ELEVENLABS_WEBHOOK_SECRET=

# Manager phone for emergency escalation (E.164, e.g. +15195551234)
MANAGER_PHONE=

# Seconds to wait for a contractor's answer before moving to the next one
CONTRACTOR_TIMEOUT_SECONDS=90

BUILDING_NAME=Maple Court
BUILDING_ADDRESS=200 University Ave W, Waterloo
