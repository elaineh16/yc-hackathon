# Relay server environment. Copy to .env.server (gitignored) and fill in. NEVER commit .env.server.
# DATABASE_URL is set automatically by `wasp start db` in development.

# Language model for the agents. Default: a local Ollama model (free, no account). Any OpenAI-compatible
# endpoint works, for example a free-tier key from a hosted provider. Without a model, the form still works.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# LLM_DISABLED=true    turns the agents off entirely (the form and the manual workflow keep working)

# Voice intake (optional). The key stays on the server; browsers get short-lived tokens.
ELEVENLABS_API_KEY=
EL_AGENT_INTAKE_ID=

# Observability (optional). Tracing fails open when unset or unreachable.
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=https://app.traceroot.ai

RELAY_TIMEZONE=America/Toronto

# Vendor discovery with Fiber AI (optional). Used only when a property has no approved vendor for a trade.
# The key stays on the server. sk_test_ keys run in Fiber's sandbox (no credits); sk_live_ keys spend credits.
# FIBER_MODE: unset = live/sandbox when a key is set, off otherwise; "fixture" = built-in fictional results (tests, demos).
FIBER_API_KEY=
# FIBER_MODE=fixture
# Cost controls (defaults shown): credits per search, a daily cap, a reserve never spent, results kept, cache days.
# FIBER_CREDITS_PER_SEARCH=2
# FIBER_DAILY_CREDIT_BUDGET=6
# FIBER_MIN_BALANCE=10
# FIBER_MAX_CANDIDATES=3
# FIBER_CACHE_DAYS=14

# Email notifications (optional, opt-in per user). In-app notifications always work without this.
# Locally: run Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit) and set SMTP_CAPTURE=true:
# captured mail is recorded as CAPTURED and never reported as delivered.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_CAPTURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Relay <relay@relay.localhost>"
# RELAY_APP_URL=http://localhost:3000
# EMAIL_MAX_PER_USER_PER_HOUR=12

# Automated tests only: enables /api/test/* (resets cases, moves the sweep clock, injects a fault).
# Refused when NODE_ENV=production. Leave unset for normal use.
# RELAY_TEST_HOOKS=true
# Optional shared token: when set, the test hooks also require the x-relay-test-token header (the tests send it from
# their own RELAY_TEST_HOOKS_TOKEN). The hooks only ever answer requests from this machine.
# RELAY_TEST_HOOKS_TOKEN=

# Limits (defaults shown): per resident per hour, and failed sign-ins per username and per address in 15 minutes.
# LIMIT_REPORTS_PER_HOUR=20
# LIMIT_CHAT_MESSAGES_PER_HOUR=60
# LIMIT_VOICE_SESSIONS_PER_HOUR=10
# LIMIT_LOGIN_FAILURES_PER_USERNAME=10
# LIMIT_LOGIN_FAILURES_PER_ADDRESS=50
# A chat turn (every model call in it) must finish within this, in milliseconds.
# INTAKE_TURN_BUDGET_MS=180000
