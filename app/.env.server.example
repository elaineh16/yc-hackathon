# Wasp server environment. cp .env.server.example .env.server and fill in. NEVER commit .env.server.
# DATABASE_URL is set automatically by `wasp start db` in development; set it explicitly on Maritime.
# DATABASE_URL=postgresql://user:pass@host:5432/relay

# Shared secret the ElevenLabs save_work_order tool sends as header X-Relay-Secret.
# Generate: openssl rand -hex 24. Unset = the intake endpoint refuses every call (fails closed).
RELAY_TOOL_SECRET=

# ElevenLabs (server only; the browser gets a short-lived conversation token, never the key).
ELEVENLABS_API_KEY=
EL_AGENT_INTAKE_ID=

# Approval policy (CAD dollars). $329 > $250 means the manager must approve.
AUTO_APPROVE_LIMIT=250
HARD_CAP=1000

# Seeded contractor progression: one result every SIM_STEP_MS (QuickFix, Bluejay, Metro, then the recommendation).
SIM_STEP_MS=3000

# Optional: require this PIN for staff/manager actions on /operator. Unset = open demo dashboard.
OPERATOR_PIN=

# TraceRoot (server only). Unset = tracing disabled; the app works the same either way.
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=https://app.traceroot.ai
# Lets TraceRoot link traces to source (optional).
TRACEROOT_GIT_REPO=elaineh16/yc-hackathon
TRACEROOT_GIT_REF=feat/wasp-core

# No-voice fallback: /?test=1 shows "Send test report (no voice)". Off unless true.
ALLOW_TEST_REPORT=false
