datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

// ───────────────────────── people and places ─────────────────────────

enum Role {
  RESIDENT
  MANAGER
  CONTRACTOR
}

// Wasp adds the auth tables (Auth, AuthIdentity, Session) and links them to this model.
model User {
  id            Int                  @id @default(autoincrement())
  createdAt     DateTime             @default(now())
  role          Role                 @default(RESIDENT)
  displayName   String
  // Contractors act on behalf of exactly one vendor.
  vendorId      String?
  vendor        Vendor?              @relation(fields: [vendorId], references: [id])
  memberships   PropertyMembership[]
  residencies   Residency[]
  reportedCases Case[]               @relation("Reporter")
  notifications Notification[]
  conversations IntakeConversation[]
  // Email is optional and opt-in. In-app notifications are always on.
  email              String?
  emailNotifications Boolean @default(false)
}

model Property {
  id                            String               @id @default(uuid())
  createdAt                     DateTime             @default(now())
  name                          String
  address                       String
  // Approval policy: a fixed estimate above this needs a manager's decision. An inspection-only response always does.
  approvalThresholdCents        Int                  @default(25000)
  // A vendor must answer an offer within this window, or the offer expires and the case returns to the manager.
  vendorResponseMinutes         Int                  @default(1440)
  // After the contractor reports completion: how often the resident is reminded, and when a manager may close unverified.
  verificationReminderMinutes   Int                  @default(1440)
  verificationCloseAfterMinutes Int                  @default(4320)
  emergencyInstructions         String               @default("If anyone is in danger, call 911 first.")
  // Building knowledge the agents can look up (shut-off valves, laundry room, access rules...). Plain text, edited in Settings.
  knowledge                     String               @default("")
  // When on, Relay's coordinator may offer routine jobs to the vendor it recommends without waiting for a manager.
  // Spending decisions, cancellations and closing are never automatic.
  autopilotRoutine              Boolean              @default(false)
  // Where the building is. Vendor discovery searches near here (city and region only; never a resident's details).
  city                          String               @default("")
  region                        String               @default("")
  latitude                      Float?
  longitude                     Float?
  // Discovered businesses farther than this from the building are flagged as outside the service area.
  serviceRadiusKm               Int                  @default(30)
  // When no approved vendor covers a trade: search for local businesses automatically (true) or wait for a manager
  // (false). Either way nothing found is contacted or dispatched until a manager verifies and approves it.
  autoDiscovery                 Boolean              @default(false)
  // Follow-ups: how long a resident has to choose a visit time, how many reminders anyone gets before a manager is
  // told instead, and how far ahead of a confirmed visit the reminder goes out.
  residentResponseMinutes       Int                  @default(1440)
  maxReminders                  Int                  @default(2)
  appointmentReminderMinutes    Int                  @default(1440)
  units                         Unit[]
  memberships                   PropertyMembership[]
  cases                         Case[]
  vendors                       PropertyVendor[]
  discoveries                   VendorDiscovery[]
  candidates                    VendorCandidate[]
}

// Which managers run which properties.
model PropertyMembership {
  id         String   @id @default(uuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Unit {
  id          String      @id @default(uuid())
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label       String
  residencies Residency[]
  cases       Case[]

  @@unique([propertyId, label])
}

// Which residents live in which units.
model Residency {
  id     String  @id @default(uuid())
  userId Int
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId String
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  active Boolean @default(true)

  @@unique([userId, unitId])
}

enum Category {
  PLUMBING
  APPLIANCE
  HVAC
  ELECTRICAL
  // Lockouts, locks, keys, fobs, entry and garage doors. Identity is verified by staff; codes are never shared.
  ACCESS
  ELEVATOR
  // Neighbour noise and conduct: handled by the manager, never a vendor job.
  NOISE
  // General or unclear: a person routes it.
  OTHER
}

// A vendor company. Contact details are shared across the portfolio; whether it may be offered work is decided
// per property (PropertyVendor).
model Vendor {
  id          String             @id @default(uuid())
  createdAt   DateTime           @default(now())
  name        String             @unique
  trades      Category[]
  phone       String?
  email       String?
  website     String?
  address     String?
  latitude    Float?
  longitude   Float?
  notes       String?
  // MANUAL (added by a manager) or DISCOVERY (onboarded from a discovered business, see VendorCandidate).
  source      String             @default("MANUAL")
  // For discovered vendors: the provider's id for the business (a Google Maps place id), used to spot duplicates.
  sourceRef   String?
  users       User[]
  assignments VendorAssignment[]
  slots       AppointmentSlot[]
  properties  PropertyVendor[]
}

// The property's vendor directory: only vendors approved here can be offered this property's work.
model PropertyVendor {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  approved     Boolean   @default(true)
  approvedAt   DateTime?
  approvedById Int?
  // MANUAL or DISCOVERY.
  source       String    @default("MANUAL")
  note         String?

  @@unique([propertyId, vendorId])
  @@index([vendorId])
}

// ───────────────────────── vendor discovery (Fiber AI) ─────────────────────────

enum DiscoveryStatus {
  // The property asks a manager before any search that may use credits.
  AWAITING_MANAGER
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  // Not run: no provider configured, the credit budget would be exceeded, or the case no longer needs it.
  SKIPPED
  CANCELLED
}

// One search for local businesses that could cover a trade the property's directory is missing.
model VendorDiscovery {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  caseId         String?
  case           Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  trade          Category
  // Exactly what was sent to the provider: a trade phrase and the building's city. Never resident details.
  query          String
  location       String
  // Same property, trade, query and location: a recent result is reused instead of making another paid call.
  cacheKey       String
  status         DiscoveryStatus   @default(QUEUED)
  // fiber | recorded
  provider       String
  // live | sandbox | recorded
  mode           String
  // SYSTEM, AGENT, or the manager's name.
  requestedBy    String
  requestedById  Int?
  attempts       Int               @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  // What the provider returned, verbatim: chargeInfo, warnings, advice.
  chargeInfo     Json?
  warnings       Json?
  advice         Json?
  creditsCharged Float?
  creditsBefore  Float?
  placesReturned Int?
  candidatesKept Int?
  errorCode      String?
  errorMessage   String?
  // A cache hit points at the discovery whose results it reused (no new call was made).
  reusedFromId   String?
  // The provider's places as returned (saved right after the call, so an interrupted job resumes without paying twice).
  response       Json?
  // Places that were returned but not kept, each with the reason (not a business, wrong trade, lower ranked...).
  filtered       Json?
  candidates     VendorCandidate[]

  @@index([propertyId, trade, createdAt])
  @@index([status, updatedAt])
  @@index([cacheKey, status])
  @@index([caseId])
}

enum CandidateStatus {
  NEW
  SHORTLISTED
  // A manager confirmed the business details (licence, insurance, contact) outside Relay.
  VERIFIED
  // Onboarded: a Vendor exists and is approved at the property. Only now can it be offered work.
  APPROVED
  REJECTED
}

// A business returned by discovery, with the checks Relay ran on the source data. Never contacted automatically.
model VendorCandidate {
  id                  String          @id @default(uuid())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  propertyId          String
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  discoveryId         String
  discovery           VendorDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  // The most recent discovery that returned this business again.
  lastDiscoveryId     String?
  timesSeen           Int             @default(1)
  trade               Category
  // fiber:google-maps | recorded:google-maps
  source              String
  // The provider's id for the business (Google Maps place id).
  sourceRef           String
  sourceUrl           String?
  name                String
  phone               String?
  website             String?
  address             String?
  categories          String[]
  rating              Float?
  reviewCount         Int?
  latitude            Float?
  longitude           Float?
  distanceKm          Float?
  openingHours        Json?
  // Deterministic checks on the source data: { categoryMatch, inServiceArea, hasContact, isBusiness, duplicate }.
  checks              Json
  // What is unknown or missing (phone, website, licence, insurance, availability...).
  missing             String[]
  duplicateOfVendorId String?
  // RECOMMENDED | POSSIBLE | NOT_RECOMMENDED, with reasons that cite only the fields above.
  recommendation      String
  reasons             String[]
  concerns            String[]
  // RULES, or the model that wrote the note (kept only if it passes the grounding check).
  assessedBy          String
  aiNote              String?
  status              CandidateStatus @default(NEW)
  reviewedById        Int?
  reviewedAt          DateTime?
  reviewNote          String?
  verifiedById        Int?
  verifiedAt          DateTime?
  verificationNote    String?
  vendorId            String?

  @@unique([propertyId, trade, sourceRef])
  @@index([discoveryId])
  @@index([propertyId, trade, status])
}

// ───────────────────────── cases ─────────────────────────

enum Severity {
  EMERGENCY
  URGENT
  ROUTINE
}

enum CaseStatus {
  NEW
  TRIAGED
  AWAITING_ASSIGNMENT
  AWAITING_VENDOR
  AWAITING_APPROVAL
  SCHEDULING
  SCHEDULED
  IN_PROGRESS
  AWAITING_VERIFICATION
  RESOLVED
  ESCALATED
  CANCELLED
  REOPENED
}

// Who holds the next action. Stored with the status so every case always has an owner.
enum Holder {
  SYSTEM
  RESIDENT
  MANAGER
  CONTRACTOR
  NONE
}

enum IntakeChannel {
  // The fallback form (works with no AI at all).
  TEXT
  // A typed conversation with Relay's intake agent.
  CHAT
  // A spoken conversation with the ElevenLabs voice agent.
  VOICE
}

enum Resolution {
  VERIFIED_BY_RESIDENT
  CLOSED_UNVERIFIED
}

model Case {
  id                      String             @id @default(uuid())
  number                  Int                @unique @default(autoincrement())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  propertyId              String
  property                Property           @relation(fields: [propertyId], references: [id])
  unitId                  String
  unit                    Unit               @relation(fields: [unitId], references: [id])
  residentId              Int
  resident                User               @relation("Reporter", fields: [residentId], references: [id])
  channel                 IntakeChannel
  // Idempotency: a retried submission with the same key returns the same case.
  clientRequestId         String
  title                   String
  // The resident's own words. Never rewritten.
  description             String
  category                Category
  severity                Severity
  emergency               Boolean            @default(false)
  // True when a person must classify or route it (unsupported category or uncertain triage).
  needsReview             Boolean            @default(false)
  // RULES | VOICE_AGENT | MANAGER: who produced the classification.
  triageSource            String
  triageReasons           String[]
  summary                 String
  // Category-specific answers (see src/shared/intake.ts).
  details                 Json
  permissionToEnter       Boolean            @default(false)
  accessNotes             String?
  status                  CaseStatus         @default(NEW)
  holder                  Holder             @default(SYSTEM)
  nextAction              String             @default("")
  nextActionDueAt         DateTime?
  statusChangedAt         DateTime           @default(now())
  verificationRequestedAt DateTime?
  verificationReminders   Int                @default(0)
  resolvedAt              DateTime?
  resolution              Resolution?
  cancelledAt             DateTime?
  cancelReason            String?
  // The coordinator's latest reading of the case, in its own words (shown to managers, labelled as AI).
  aiAssessment            String?
  aiAssessedAt            DateTime?
  // Intake's reading, kept apart: what the resident said they observed, what Relay inferred, what is still unknown.
  observations            String[]           @default([])
  assumptions             String[]           @default([])
  openQuestions           String[]           @default([])
  // Cases filed from one multi-issue report share this id.
  intakeGroup             String?
  // Durable "the coordinator should look at this" marker, set in the same transaction as the triggering event.
  // Cleared when a coordinator run finishes; the minute sweep re-queues anything left set (crash recovery).
  agentPendingSince       DateTime?
  agentPendingTrigger     String?
  agentPendingEventId     Int?
  assignments             VendorAssignment[]
  approvals               SpendApproval[]
  slots                   AppointmentSlot[]
  events                  CaseEvent[]
  notifications           Notification[]
  agentRuns               AgentRun[]
  proposals               AgentProposal[]
  conversation            IntakeConversation?
  discoveries             VendorDiscovery[]

  @@unique([residentId, clientRequestId])
  @@index([propertyId, status])
  @@index([holder, status])
  @@index([status, statusChangedAt])
  @@index([agentPendingSince])
}

// ───────────────────────── agents ─────────────────────────

enum ConversationStatus {
  OPEN
  SUBMITTED
  ABANDONED
}

// A resident's conversation with the intake agent. Persisted, so it survives reloads and server restarts.
model IntakeConversation {
  id              String             @id @default(uuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  residentId      Int
  resident        User               @relation(fields: [residentId], references: [id], onDelete: Cascade)
  unitId          String
  status          ConversationStatus @default(OPEN)
  // [{ role: "resident" | "relay", text, at }]: what both sides actually said.
  messages        Json               @default("[]")
  // What the agent has learned so far, as structured facts it recorded with the note_facts tool.
  facts           Json               @default("{}")
  // Idempotency key for the submission, so a retried submit returns the same case.
  clientRequestId String             @default(uuid())
  caseId          String?            @unique
  case            Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  runs            AgentRun[]
  // A resident message is waiting for Relay's reply. The model runs in a background job, never in the request.
  pendingSince    DateTime?
  pendingAttempts Int                @default(0)
  // The last failure, in plain words, when a reply could not be produced.
  lastError       String?

  @@index([residentId, status])
  @@index([pendingSince])
}

enum AgentKind {
  INTAKE
  COORDINATOR
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// One reasoning pass by an agent: what triggered it, which model, every tool it called with the result, and how it ended.
model AgentRun {
  id             String              @id @default(uuid())
  createdAt      DateTime            @default(now())
  finishedAt     DateTime?
  kind           AgentKind
  caseId         String?
  case           Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   IntakeConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  trigger        String
  // Coordinator runs: the case event that woke it. One run per (case, trigger, event), so a retried job is a no-op.
  triggerKey     String?             @unique
  model          String
  status         AgentRunStatus      @default(RUNNING)
  // [{ tool, args, ok, result }] in the order the agent called them.
  steps          Json                @default("[]")
  finalText      String?
  error          String?
  durationMs     Int?
  proposals      AgentProposal[]

  @@index([caseId, createdAt])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXECUTED
  FAILED
  SUPERSEDED
}

// Something the coordinator wants done. Deterministic policy decides whether it runs straight away or waits for a manager.
model AgentProposal {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  runId       String
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  // ASSIGN_VENDOR | MESSAGE_RESIDENT | ESCALATE
  kind        String
  payload     Json
  rationale   String
  status      ProposalStatus @default(PENDING)
  // Why policy let it run automatically or held it for a person.
  policyNote  String
  decidedById Int?
  decidedAt   DateTime?
  outcome     String?

  @@index([caseId, status])
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  REJECTED
  CANCELLED
  COMPLETED
}

enum EstimateType {
  FIXED
  INSPECTION_REQUIRED
}

// One offer of a case to a vendor, and everything that vendor did with it.
// A raw-SQL partial unique index allows at most one live (OFFERED or ACCEPTED) assignment per case.
model VendorAssignment {
  id              String            @id @default(uuid())
  caseId          String
  case            Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  status          AssignmentStatus  @default(OFFERED)
  offeredById     Int
  offeredAt       DateTime          @default(now())
  respondByAt     DateTime
  noteToVendor    String?
  respondedAt     DateTime?
  respondedById   Int?
  declineReason   String?
  estimateType    EstimateType?
  estimateCents   Int?
  estimateNotes   String?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  finalCostCents  Int?
  // The contractor asked to raise the approved amount mid-job. Only a manager can decide it.
  changeRequestCents  Int?
  changeRequestReason String?
  // PENDING | APPROVED | REJECTED
  changeRequestStatus String?
  changeRequestedAt   DateTime?
  changeDecidedAt     DateTime?
  changeDecidedById   Int?
  approval        SpendApproval?
  slots           AppointmentSlot[]

  @@index([vendorId, status])
  @@index([caseId, status])
  @@index([status, respondByAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
  VOID
}

// The spending decision for one accepted assignment. Keeps the policy that applied at the time.
model SpendApproval {
  id             String           @id @default(uuid())
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignmentId   String           @unique
  assignment     VendorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status         ApprovalStatus
  amountCents    Int?
  thresholdCents Int
  capCents       Int?
  requestedAt    DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    Int?
  note           String?
}

enum SlotStatus {
  PROPOSED
  ACCEPTED
  CONFIRMED
  DECLINED
  WITHDRAWN
  SUPERSEDED
  CANCELLED
  UNAVAILABLE
}

// A visit window proposed by the contractor. PROPOSED -> ACCEPTED (resident agreed, spend not yet approved)
// -> CONFIRMED (everyone required has agreed and the vendor has no clash).
model AppointmentSlot {
  id                 String           @id @default(uuid())
  caseId             String
  case               Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignmentId       String
  assignment         VendorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id])
  startAt            DateTime
  endAt              DateTime
  status             SlotStatus       @default(PROPOSED)
  proposedById       Int
  proposedAt         DateTime         @default(now())
  residentAnsweredAt DateTime?
  confirmedAt        DateTime?

  @@index([vendorId, status, startAt])
  @@index([caseId, status])
  @@index([assignmentId, status])
}

enum Audience {
  EVERYONE
  MANAGEMENT
  VENDOR
}

// Append-only history. Every state change and every action writes one row in the same transaction.
model CaseEvent {
  id          Int         @id @default(autoincrement())
  caseId      String
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  actorUserId Int?
  // RESIDENT | MANAGER | CONTRACTOR | SYSTEM
  actorRole   String
  actorName   String
  type        String
  fromStatus  CaseStatus?
  toStatus    CaseStatus?
  message     String
  // EVERYONE: all parties. MANAGEMENT: managers only. VENDOR: managers and the vendor in vendorId.
  audience    Audience    @default(EVERYONE)
  vendorId    String?
  data        Json?

  @@index([caseId, id])
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

// What actually happened to a notification. Nothing claims more than the channel can prove:
//   DELIVERED  in-app: it is in the recipient's Relay inbox
//   ACCEPTED   email: the SMTP server accepted it (delivery to the mailbox is not confirmed)
//   CAPTURED   email: a local capture server (Mailpit) accepted it; it was NOT delivered to anyone
//   SKIPPED    not sent, with the reason (no address, not opted in, email not configured, send limit)
enum DeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  ACCEPTED
  CAPTURED
  FAILED
  SKIPPED
}

// One notification per recipient, event and channel. The dedupe key makes every send idempotent.
model Notification {
  id                String              @id @default(uuid())
  userId            Int
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId            String?
  case              Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  // How it is shown: ACTION, UPDATE, EMERGENCY, ...
  kind              String
  // What happened: case.received, action.needed, appointment.proposed, appointment.reminder, repair.completed, ...
  eventType         String              @default("case.update")
  channel           NotificationChannel @default(IN_APP)
  title             String
  body              String
  // Where the recipient acts. A plain app link: it requires signing in and carries no token.
  actionUrl         String?
  status            DeliveryStatus      @default(DELIVERED)
  scheduledFor      DateTime            @default(now())
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?
  lastError         String?
  sentAt            DateTime?
  providerMessageId String?
  // Why it was skipped or failed, in plain words.
  statusNote        String?
  // Needs the recipient to act or acknowledge by ackDueAt; acting on the case acknowledges it.
  ackRequired       Boolean             @default(false)
  ackDueAt          DateTime?
  readAt            DateTime?
  acknowledgedAt    DateTime?
  // An overdue acknowledgement was escalated to the managers (once per alert, by the sweep).
  escalatedAt       DateTime?
  dedupeKey         String              @unique

  @@index([userId, channel, readAt])
  @@index([channel, status, scheduledFor])
  @@index([ackRequired, acknowledgedAt, ackDueAt])
  @@index([caseId, createdAt])
}
