datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

// One student's browser. Its id is the capability that lets that page read its own work order.
model DemoSession {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]
}

model WorkOrder {
  id                String             @id @default(uuid())
  number            Int                @unique @default(autoincrement())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessionId         String
  session           DemoSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // "mkv|main laundry room|washer 2" while the order is open: one open order per machine.
  openKey           String?            @unique
  residence         String
  room              String
  machine           String
  symptom           String
  floorStatus       String // DRY | WET | UNKNOWN
  reportedErrorCode String? // what the student read off the display; never a diagnosis
  safetyHazard      Boolean            @default(false)
  hazardDetails     String?
  intakeCount       Int                @default(1)
  intakeFingerprint String
  conversationId    String?
  // Repair lane: OPTIONS_PENDING -> RECOMMENDED -> PENDING_APPROVAL -> CONFIRMATION_PENDING -> CONFIRMED,
  // or DENIED, or ESCALATED (safety hazard: normal flow stopped).
  repairStatus      String             @default("OPTIONS_PENDING")
  optionsStartedAt  DateTime?
  recommendedKey    String?
  recommendation    String?
  staffRequest      StaffRequest?
  contractorResults ContractorResult[]
  decision          ManagerDecision?
  appointment       Appointment?
  events            TimelineEvent[]
}

// Staff lane: REQUESTED -> ACCEPTED (ETA) -> RETRIEVED, or UNAVAILABLE (manager takes over retrieval).
model StaffRequest {
  id            String    @id @default(uuid())
  workOrderId   String    @unique
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  desk          String
  status        String    @default("REQUESTED")
  priority      String    @default("NORMAL") // NORMAL | SAFETY
  assignedTo    String    @default("STAFF") // STAFF | MANAGER
  etaMinutes    Int?
  note          String?
  requestedAt   DateTime  @default(now())
  acceptedAt    DateTime?
  retrievedAt   DateTime?
  unavailableAt DateTime?
  updatedAt     DateTime  @updatedAt
}

// Seeded, simulated contractor outreach results. Never a live call.
model ContractorResult {
  id            String    @id @default(uuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractorKey String
  name          String
  outcome       String // QUOTED | DIAGNOSTIC_ONLY | VOICEMAIL
  scope         String // REPAIR | DIAGNOSTIC | UNKNOWN
  availability  String?
  priceCents    Int?
  currency      String    @default("CAD")
  priceNote     String?
  summary       String
  simulated     Boolean   @default(true)
  receivedAt    DateTime  @default(now())

  @@unique([workOrderId, contractorKey])
}

model ManagerDecision {
  id                    String    @id @default(uuid())
  workOrderId           String    @unique
  workOrder             WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractorKey         String
  contractorName        String
  estimateCents         Int // Bluejay: 32900, before tax
  estimateNote          String
  autoApproveLimitCents Int
  status                String    @default("PENDING") // PENDING | APPROVED | DENIED
  approvedCapCents      Int? // all-in cap, taxes and fees included
  capNote               String?
  decidedBy             String?
  note                  String?
  requestedAt           DateTime  @default(now())
  decidedAt             DateTime?
}

// Simulated appointment. Exists only after manager approval + simulated confirmation.
model Appointment {
  id             String    @id @default(uuid())
  workOrderId    String    @unique
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractorKey  String
  contractorName String
  arrivalWindow  String
  arrivalStart   DateTime
  arrivalEnd     DateTime
  status         String    @default("CONFIRMED")
  simulated      Boolean   @default(true)
  confirmedAt    DateTime  @default(now())
}

model TimelineEvent {
  id             String    @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  lane           String // INTAKE | STAFF | REPAIR
  type           String
  actor          String // RELAY | STUDENT | STAFF | MANAGER | SYSTEM
  message        String
  studentMessage String? // null = not shown on the student page
  simulated      Boolean   @default(false)
  // One event per step: repeated actions and polling can never write a second copy.
  dedupeKey      String    @unique

  @@index([workOrderId, createdAt])
}
