app relay {
  wasp: {
    version: "^0.22.0"
  },
  title: "Relay",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ]
}

// ---------- pages ----------
route StudentRoute { path: "/", to: StudentPage }
page StudentPage {
  component: import { StudentPage } from "@src/client/StudentPage"
}

route OperatorRoute { path: "/operator", to: OperatorPage }
page OperatorPage {
  component: import { OperatorPage } from "@src/client/OperatorPage"
}

// ---------- student ----------
action createDemoSession {
  fn: import { createDemoSession } from "@src/server/operations",
  entities: [DemoSession]
}
action startVoiceSession {
  fn: import { startVoiceSession } from "@src/server/voice",
  entities: [DemoSession]
}
query getStudentStatus {
  fn: import { getStudentStatus } from "@src/server/operations",
  entities: [DemoSession, WorkOrder, StaffRequest, ContractorResult, ManagerDecision, Appointment, TimelineEvent]
}

// ---------- operator dashboard ----------
query getOperatorDashboard {
  fn: import { getOperatorDashboard } from "@src/server/operations",
  entities: [WorkOrder, StaffRequest, ContractorResult, ManagerDecision, Appointment, TimelineEvent]
}
action staffAccept {
  fn: import { staffAccept } from "@src/server/operations",
  entities: [StaffRequest, TimelineEvent]
}
action staffMarkRetrieved {
  fn: import { staffMarkRetrieved } from "@src/server/operations",
  entities: [StaffRequest, TimelineEvent]
}
action staffMarkUnavailable {
  fn: import { staffMarkUnavailable } from "@src/server/operations",
  entities: [StaffRequest, TimelineEvent]
}
action approveRepair {
  fn: import { approveRepair } from "@src/server/operations",
  entities: [WorkOrder, ManagerDecision, TimelineEvent]
}
action denyRepair {
  fn: import { denyRepair } from "@src/server/operations",
  entities: [WorkOrder, ManagerDecision, TimelineEvent]
}
action simulateConfirmation {
  fn: import { simulateConfirmation } from "@src/server/operations",
  entities: [WorkOrder, ManagerDecision, Appointment, TimelineEvent]
}
action resetDemo {
  fn: import { resetDemo } from "@src/server/operations",
  entities: [DemoSession, WorkOrder, StaffRequest, ContractorResult, ManagerDecision, Appointment, TimelineEvent]
}

// ---------- public HTTP ----------
// ElevenLabs server tool. Requires header X-Relay-Secret = RELAY_TOOL_SECRET. Contract: README.md.
api relayIntake {
  fn: import { relayIntake } from "@src/server/intakeApi",
  httpRoute: (POST, "/api/relay/intake"),
  entities: [DemoSession, WorkOrder, StaffRequest, TimelineEvent]
}
api health {
  fn: import { health } from "@src/server/intakeApi",
  httpRoute: (GET, "/health")
}
