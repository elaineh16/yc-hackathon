# Relay — Wasp server environment only
# Never commit real .env files or expose secrets to the browser.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ElevenLabs browser voice intake (server only)
ELEVENLABS_API_KEY=
EL_AGENT_INTAKE_ID=
RELAY_TOOL_SECRET=

# Maritime public URL, no trailing slash
PUBLIC_BASE_URL=

# TraceRoot — required for server-side agent/workflow observability
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=https://app.traceroot.ai
# Optional CLI/project selector; API keys may already be project-scoped.
TRACEROOT_PROJECT_ID=

# Demo safety
DEMO_MODE=true

# Optional legacy Twilio configuration only if an existing integration is deliberately retained.
# It is not required by the browser-based judging flow.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
